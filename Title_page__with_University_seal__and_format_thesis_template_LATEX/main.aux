\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Molecular heterogeneity and personalized care}{5}{subsection.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Longitudinal response assessment according to the Response Assessment in Neuro-Oncology (RANO) 2.0 criteria. In newly diagnosed Glioblastoma, the post Radiotherapy MRI is used as the baseline for subsequent response assessment. Because pseudoprogression is frequent during the first 12 weeks after completion of radiotherapy or concurrent chemoradiotherapy, apparent progression during this period requires confirmation by repeat MRI or histopathological evidence of unequivocal recurrent tumor before progressive disease is declared. This temporal framework highlights the importance of incorporating scan timing, treatment exposure, and serial imaging trajectories into computational models of tumor dynamics. Adapted from \cite  {sakata2024rano}.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:rano2_pseudoprogression_timeline}{{3}{6}{Longitudinal response assessment according to the Response Assessment in Neuro-Oncology (RANO) 2.0 criteria. In newly diagnosed Glioblastoma, the post Radiotherapy MRI is used as the baseline for subsequent response assessment. Because pseudoprogression is frequent during the first 12 weeks after completion of radiotherapy or concurrent chemoradiotherapy, apparent progression during this period requires confirmation by repeat MRI or histopathological evidence of unequivocal recurrent tumor before progressive disease is declared. This temporal framework highlights the importance of incorporating scan timing, treatment exposure, and serial imaging trajectories into computational models of tumor dynamics. Adapted from \cite {sakata2024rano}}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Molecular heterogeneity in Glioblastoma. Molecular alterations, including \textit  {IDH} mutation status, \textit  {MGMT} promoter Methylation, \textit  {TERT} promoter mutation, \textit  {EGFR} amplification, \textit  {PTEN} alteration, \textit  {CDKN2A/B} deletion, and \textit  {TP53} alteration, influence prognosis, treatment sensitivity, and expected tumor behavior. \textit  {IDH}-mutant Gliomas generally have a more favorable prognosis than \textit  {IDH}-wildtype tumors, whereas \textit  {MGMT} promoter methylation is associated with greater temozolomide sensitivity and improved survival. These molecular features provide important biological context for interpreting apparently similar MRI phenotypes and for personalizing computational models of tumor growth and treatment response. Adapted from \cite  {zhu2024molecular}.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:gbm_molecular_heterogeneity}{{4}{7}{Molecular heterogeneity in Glioblastoma. Molecular alterations, including \textit {IDH} mutation status, \textit {MGMT} promoter Methylation, \textit {TERT} promoter mutation, \textit {EGFR} amplification, \textit {PTEN} alteration, \textit {CDKN2A/B} deletion, and \textit {TP53} alteration, influence prognosis, treatment sensitivity, and expected tumor behavior. \textit {IDH}-mutant Gliomas generally have a more favorable prognosis than \textit {IDH}-wildtype tumors, whereas \textit {MGMT} promoter methylation is associated with greater temozolomide sensitivity and improved survival. These molecular features provide important biological context for interpreting apparently similar MRI phenotypes and for personalizing computational models of tumor growth and treatment response. Adapted from \cite {zhu2024molecular}}{figure.caption.5}{}}
