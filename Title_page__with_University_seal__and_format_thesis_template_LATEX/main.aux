\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}The need for the longitudinal interpretation}{3}{subsection.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Pseudoprogression in Glioblastoma. (A) Immediate pre Radiotherapy: axial T1 post contrast images show rim enhancing and centrally necrotic left frontoparietal Glioblastoma; (B) Eight week follow-up: immediate post Radiotherapy axial T1 post contrast images show marked increase in enhancement and necrosis; (C) dynamic susceptibility weighted contrast enhanced perfusion MRI shows mild increase in blood volume along the posterior rim (black arrows), while single voxel proton spectroscopy targeted to the posterior component shows a markedly increased lipid peak suggesting tissue necrosis; (D) Three month follow up: axial T1 contrast images show marked decrease in enhancement and necrosis of the treated Glioblastoma. Adapted from \cite  {carrete2022advanced}.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:glioblastoma_pseudoprogression}{{2}{4}{Pseudoprogression in Glioblastoma. (A) Immediate pre Radiotherapy: axial T1 post contrast images show rim enhancing and centrally necrotic left frontoparietal Glioblastoma; (B) Eight week follow-up: immediate post Radiotherapy axial T1 post contrast images show marked increase in enhancement and necrosis; (C) dynamic susceptibility weighted contrast enhanced perfusion MRI shows mild increase in blood volume along the posterior rim (black arrows), while single voxel proton spectroscopy targeted to the posterior component shows a markedly increased lipid peak suggesting tissue necrosis; (D) Three month follow up: axial T1 contrast images show marked decrease in enhancement and necrosis of the treated Glioblastoma. Adapted from \cite {carrete2022advanced}}{figure.caption.3}{}}
