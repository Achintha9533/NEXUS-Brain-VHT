\contentsline {figure}{\numberline {15}{\ignorespaces MCMC convergence diagnostics for Fisher-KPP hyperpriors ($\mu _{\log \rho }, \mu _{\log D}, \mu _{\log K}$): (a) posterior densities and stationary iteration traces across 4 independent chains, and (b) rank plots demonstrating uniform distribution and unbiased mixing.}}{41}{figure.caption.17}%
\contentsline {figure}{\numberline {16}{\ignorespaces Longitudinal tumor volume projections for Patient ID\_0003: (a) baseline unconstrained growth trajectory projecting to $210,858.7\text { mm}^3$ at Day 466, and (b) counterfactual trajectory excluding surgical resection but incorporating targeted Radiotherapy scheduling, demonstrating therapeutic growth damping relative to the baseline.}}{44}{figure.caption.20}%
\contentsline {figure}{\numberline {17}{\ignorespaces Longitudinal tumor volume projections for Patient ID\_0003: (a) baseline unconstrained growth trajectory projecting to $210,858.7\text { mm}^3$ at Day 466, and (b) counterfactual trajectory incorporating an 80\% surgical resection on Day 336 combined with multi modal therapeutic scheduling, achieving a final volume of $156,528.2\text { mm}^3$ (25.8\% reduction) at Day 466.}}{45}{figure.caption.21}%
